// Fonte da verdade do modelo de dados do kindred (doc: docs-tec/02-modelo-de-dados.md).
// Só o @kindred/db conhece o Prisma; os apps importam os tipos e o client deste pacote.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id               String           @id @default(uuid())
  name             String
  sex              Sex?
  birthDate        DateTime?
  deathDate        DateTime?
  deceased         Boolean          @default(false)
  relationshipType RelationshipType
  isCentralUser    Boolean          @default(false)

  fatherId         String?
  father           Person?          @relation("Father", fields: [fatherId], references: [id])
  childrenAsFather Person[]         @relation("Father")

  motherId         String?
  mother           Person?          @relation("Mother", fields: [motherId], references: [id])
  childrenAsMother Person[]         @relation("Mother")

  locationId       String?
  location         Location?        @relation(fields: [locationId], references: [id])

  // Uniões conjugais. Uma união é simétrica, mas o Postgres precisa de dois lados;
  // o serviço normaliza a ordem do par (ver RN-011), então basta somar as duas listas
  // para ter todas as uniões de uma pessoa.
  unionsAsA        Union[]          @relation("PartnerA")
  unionsAsB        Union[]          @relation("PartnerB")

  photo            PersonPhoto?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("people")
}

/// A foto de perfil, guardada no próprio banco (ADR-011).
///
/// Tabela à parte de propósito: o Prisma traz todas as colunas escalares em
/// `findMany`, e a lista, a árvore e o calendário carregam todo mundo de uma vez.
/// Com os bytes aqui, eles nunca vêm junto — só quem pede a foto pela rota dela
/// paga o preço.
model PersonPhoto {
  personId  String   @id
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// JPEG, PNG ou WebP; o web reduz a imagem antes de enviar (RN-017).
  bytes     Bytes
  mimeType  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("person_photos")
}

/// União conjugal entre duas pessoas. É entidade, e não um campo `spouseId`, porque
/// tem dados próprios (início, fim, situação) e porque uma pessoa pode ter tido mais
/// de uma ao longo da vida — é o que distingue cônjuge de ex (ADR-008).
model Union {
  id         String      @id @default(uuid())
  partnerAId String
  partnerA   Person      @relation("PartnerA", fields: [partnerAId], references: [id], onDelete: Cascade)
  partnerBId String
  partnerB   Person      @relation("PartnerB", fields: [partnerBId], references: [id], onDelete: Cascade)
  status     UnionStatus @default(CURRENT)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([partnerAId, partnerBId])
  @@index([partnerBId])
  @@map("unions")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  people    Person[]

  @@map("locations")
}

enum Sex {
  MALE
  FEMALE
}

enum RelationshipType {
  FAMILY
  FRIEND
  ACQUAINTANCE
  OTHER
}

enum UnionStatus {
  /// União vigente — é por ela que o parentesco por afinidade se propaga (RN-013).
  CURRENT
  /// União desfeita: a pessoa é "ex". Não propaga afinidade.
  ENDED
}
