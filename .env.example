# Banco de dados. O `docker compose up -d postgres` publica o Postgres em localhost:5432;
# dentro do compose (serviços api/migrate) o host é `postgres` e a URL é injetada de lá.
DATABASE_URL="postgresql://kindred:kindred123@localhost:5432/kindred?schema=public"

# Porta HTTP da API (o dev server do web faz proxy de /api para cá).
PORT=3000
