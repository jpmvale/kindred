{
  "name": "kindred",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kindred/db db:generate",
    "db:migrate": "pnpm --filter @kindred/db db:migrate",
    "db:migrate:dev": "pnpm --filter @kindred/db db:migrate:dev",
    "db:seed": "pnpm --filter @kindred/db db:seed",
    "db:backfill-owner": "pnpm --filter @kindred/db db:backfill-owner",
    "db:backup": "pnpm --filter @kindred/db db:backup",
    "db:restore": "pnpm --filter @kindred/db db:restore",
    "db:anonymize": "pnpm --filter @kindred/db db:anonymize",
    "db:studio": "pnpm --filter @kindred/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}
